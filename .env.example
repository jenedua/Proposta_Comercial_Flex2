# Local Postgres for Docker development.
POSTGRES_PORT=5433
POSTGRES_DB=proposta_flex
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/proposta_flex?schema=public"

# Connection string used by Prisma CLI and migrations.
# In production on Neon, point this to the direct connection URL.
MIGRATIONS_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/proposta_flex?schema=public"

# JWT secret for API authentication.
JWT_SECRET="change-me-before-production"

# Optional HTTP port used by `npm run dev`.
PORT=3001

# Optional host used by the local Express server.
HOST=0.0.0.0

# Optional websocket port used by Vite HMR in middleware mode.
# Change this if you see "WebSocket server error: Port ... is already in use".
VITE_HMR_PORT=24679

# Set to true to disable HMR completely if websocket conflicts persist.
DISABLE_HMR=false
